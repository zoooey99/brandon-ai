# ============================================================================
# iMessage Relay Server - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it contains secrets)

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Remote server URL (your backend server)
REMOTE_SERVER_URL=https://your-backend-server.com

# Path to Messages database (macOS only)
# Default: ~/Library/Messages/chat.db
CHAT_DB=/Users/yourname/Library/Messages/chat.db

# ============================================================================
# SECURITY CONFIGURATION (HIGHLY RECOMMENDED)
# ============================================================================

# API key for authenticating requests TO this Mac server
# Generate a secure random string (e.g., using: openssl rand -base64 32)
# Your backend must send this in the Authorization header as "Bearer <key>"
# WARNING: If not set, your API endpoints will be UNPROTECTED!
MAC_SERVER_APIKEY=your_secure_api_key_here

# API key for authenticating requests FROM this Mac server to your backend
# Sent in the Authorization header when forwarding messages to /mac/webhook
# Optional - only needed if your backend requires authentication
REMOTE_SERVER_APIKEY=your_backend_api_key_here

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Server Configuration
# --------------------
PORT=8787
LOCAL_DB_PATH=./local.db

# Polling interval (milliseconds) for checking Messages database
POLL_MS=1500

# Message Sending
# ---------------
# Default delay (seconds) between sending each message chunk
INTER_CHUNK_DELAY_SECONDS=0.7

# Typing Indicator
# ----------------
# Placeholder text shown while typing indicator is active
PLACEHOLDER_TEXT=...

# AppleScript Paths
# -----------------
# Paths to AppleScript files (defaults shown)
# TYPING_SCRIPT=./typing.scpt
# CLEAR_INPUT_SCRIPT=./Clear_input.scpt
# SEND_SCRIPT=./send_imessage.scpt

# Logging
# -------
# Enable verbose logging (shows full message content in logs)
# WARNING: This logs sensitive message content - only use for debugging
# Default: false (truncates messages to 50 chars)
ENABLE_VERBOSE_LOGGING=false

# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# 1. ALWAYS set MAC_SERVER_APIKEY in production
# 2. Use strong, randomly generated API keys (32+ characters)
# 3. Never commit .env to version control
# 4. Rotate API keys regularly
# 5. Only expose this server to trusted networks
#
# ============================================================================
