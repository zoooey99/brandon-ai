# ============================================
# SERVER-ONLY SECRETS (never exposed to client)
# ============================================

# Database (Supabase PostgreSQL)
# Get this from: Supabase Dashboard → Settings → Database → Connection String → Session Pooler
# IMPORTANT: URL-encode special characters in password (@ = %40, # = %23, etc.)
# Using Session Pooler (port 5432) for Render/Vercel IPv4 compatibility
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase - Service Role Key (KEEP SECRET!)
# Get this from: Supabase Dashboard → Settings → API → service_role key
# This key bypasses Row Level Security - NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe - Secret Key (KEEP SECRET!)
# Get this from: Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_...

# Stripe - Webhook Secret (KEEP SECRET!)
# Get this from: Stripe Dashboard → Developers → Webhooks → Your webhook → Signing secret
# Webhook endpoint: https://your-domain.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe - Price IDs
# Create products/prices in Stripe Dashboard → Products
# Use test-mode IDs for development, live-mode IDs for production
STRIPE_YEARLY_PRICE_ID=price_...
STRIPE_MONTHLY_PRICE_ID=price_...

# AI Service (FastAPI backend)
# URL of your FastAPI backend that handles AI generation
AI_SERVICE_URL=https://your-fastapi-backend.com
AI_SERVICE_API_KEY=your-api-key-here

# Resend (email service for feedback)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Twilio Verify (phone verification via SMS)
# Get these from: Twilio Console → Account Info + Verify → Services
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_VERIFY_SERVICE_SID=VA...

# ============================================
# SHARED (used by both server and client)
# ============================================

# Supabase - Project URL (safe to expose)
# Get this from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://[project-ref].supabase.co

# Supabase - Anon Key (safe to expose)
# This key respects Row Level Security policies
SUPABASE_ANON_KEY=eyJ...

# ============================================
# CLIENT-ONLY (VITE_ prefix exposes to browser)
# ============================================
# These are the SAME values as above, but with VITE_ prefix
# Vite only exposes env vars with VITE_ prefix to the client bundle

VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# PostHog analytics (optional - leave empty to disable)
VITE_POSTHOG_KEY=phc_...

# Stripe - Publishable Key (safe to expose)
# This key can only tokenize cards, not charge them
STRIPE_PUBLISHABLE_KEY=pk_...

# ============================================
# GOOGLE OAUTH SETUP (in Supabase Dashboard)
# ============================================
# 1. Go to Supabase Dashboard → Authentication → Providers
# 2. Enable Google provider
# 3. Get Google OAuth credentials from Google Cloud Console:
#    - Create OAuth 2.0 Client ID
#    - Add authorized redirect URI: https://[project-ref].supabase.co/auth/v1/callback
# 4. Enter Client ID and Client Secret in Supabase Dashboard
