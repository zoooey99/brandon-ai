# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Mac Server Integration
MAC_SERVER_URL=http://localhost:8787
MAC_SERVER_APIKEY=your_mac_server_api_key_here
REMOTE_SERVER_APIKEY=generate_with_openssl_rand_base64_32

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Models: gpt-5-nano, gpt-5-mini, gpt-5, gpt-5.2, gpt-5.2-pro, gpt-4.1, gpt-4o-mini, gpt-4o
OPENAI_MODEL=gpt-5-mini

# Helicone Observability (optional - leave empty to disable)
# Get your API key at https://helicone.ai
HELICONE_API_KEY=

# Frontend API Authentication
# API key for frontend endpoints (/api/generate-plan, /api/coach-chat)
FRONTEND_APIKEY=your_frontend_api_key_here

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# Admin UI Authentication (REQUIRED - no defaults!)
# Generate with: openssl rand -base64 32
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_SECRET_KEY=your_random_secret_key_min_32_chars_here

# Stripe Configuration (required for subscription management)
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_your_stripe_secret_key_here
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
